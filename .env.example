# ============ WAJIB ============
DATABASE_URL=postgres://USER:PASSWORD@client_bos-syam-db:5432/client?sslmode=disable
SESSION_SECRET=            # wajib >= 32 karakter; node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production
APP_BASE_URL=https://namaapp.maulanacorp.my.id
NEXT_PUBLIC_APP_NAME=BOS Syams
SESSION_COOKIE_NAME=bos_syams_session

# ============ Seed admin (opsional) ============
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin
SEED_OWNER_PASSWORD=owner123 # opsional; kosong = pakai owner123

# ============ Google OAuth (kalau login pakai Google) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://namaapp.maulanacorp.my.id/api/auth/google/callback
ALLOWED_EMAIL_DOMAINS=     # kosong = semua domain, mis. maulanacorp.my.id

# ============ Telegram (kalau ada laporan otomatis) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ AI (kalau ada AI insight) ============
AI_URL_1=
AI_KEY_1=
AI_MODEL_1=
AI_URL_2=
AI_KEY_2=
AI_MODEL_2=

# ============ Marketplace (kalau ada integrasi) ============
APP_MODE=mock              # mock | live
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REGION=ID
SHOPEE_BASE_URL=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI=https://namaapp.maulanacorp.my.id/api/shopee/callback
