# ============ WAJIB ============
DATABASE_URL=postgresql://user:password@host-internal-easypanel:5432/nama_db
SESSION_SECRET=            # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production
APP_BASE_URL=https://namaapp.maulanacorp.my.id
NEXT_PUBLIC_APP_NAME=Nama App

# ============ Seed admin (opsional) ============
SEED_ADMIN_PASSWORD=       # kosong = pakai admin123
SEED_ADMIN_EMAIL=

# ============ Google OAuth (kalau login pakai Google) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://namaapp.maulanacorp.my.id/api/auth/google/callback
ALLOWED_EMAIL_DOMAINS=     # kosong = semua domain, mis. maulanacorp.my.id

# ============ Telegram (kalau ada laporan otomatis) ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ AI (kalau ada AI insight) ============
AI_URL_1=
AI_KEY_1=
AI_MODEL_1=
AI_URL_2=
AI_KEY_2=
AI_MODEL_2=

# ============ Marketplace (kalau ada integrasi) ============
APP_MODE=mock              # mock | live
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REGION=ID
SHOPEE_BASE_URL=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI=https://namaapp.maulanacorp.my.id/api/shopee/callback
